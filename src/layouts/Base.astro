---
import '@/styles/global.css'
import { site } from '@/data/copy'

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpsMaxx" />
    <meta property="og:image" content={`${site.url}/shots/fleet.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.url}/shots/fleet.png`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/shots/fleet.png" />

    <!-- Light is the default. Only a stored preference turns the page dark,
         so a first-time visitor never gets a flash of the wrong theme. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark')
        }
      } catch (e) {}
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'OpsMaxx',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Windows, macOS, Linux',
        softwareVersion: site.version,
        license: 'https://opensource.org/licenses/MIT',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        url: site.url
      })}
    />
  </head>
  <body class="min-h-screen bg-background font-sans">
    <slot />

    <!-- Reveal-on-scroll and the counters. Deliberately not a framework:
         a single rAF-throttled pass, no hydration, and it degrades to
         "everything visible" if it never runs. The pass is a sweep rather
         than an observer so that scrolling past a section quickly can never
         leave it stuck invisible. -->
    <script is:inline>
      ;(function () {
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
        var pending = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'))

        function showAll() {
          pending.forEach(function (el) { el.classList.add('is-static') })
          document.querySelectorAll('[data-count]').forEach(function (el) {
            el.textContent = el.getAttribute('data-count')
          })
          pending = []
        }

        if (reduced) return showAll()

        // Stagger siblings inside a group, so a grid arrives as a wave.
        document.querySelectorAll('[data-reveal-group]').forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (child, i) {
            var el = child.hasAttribute('data-reveal') ? child : child.querySelector('[data-reveal]')
            if (el) el.style.setProperty('--reveal-delay', Math.min(i, 8) * 55 + 'ms')
          })
        })

        var queued = false
        function schedule() {
          if (queued) return
          queued = true
          requestAnimationFrame(sweep)
        }

        function sweep() {
          queued = false
          var limit = innerHeight * 0.9
          var still = []
          for (var i = 0; i < pending.length; i++) {
            var el = pending[i]
            if (el.getBoundingClientRect().top < limit) {
              el.classList.add('is-in')
              var c = el.matches('[data-count]') ? el : el.querySelector('[data-count]')
              if (c) count(c)
            } else {
              still.push(el)
            }
          }
          pending = still
          if (!pending.length) {
            removeEventListener('scroll', schedule)
            removeEventListener('resize', schedule)
          }
        }

        // Counts up to the number in data-count, keeping any suffix ("20+").
        function count(el) {
          if (el.dataset.counted) return
          el.dataset.counted = '1'
          var raw = el.getAttribute('data-count')
          var target = parseInt(raw, 10)
          if (isNaN(target)) return
          var suffix = raw.replace(/^[0-9]+/, '')
          if (target === 0) { el.textContent = '0' + suffix; return }
          var start = performance.now()
          function frame(now) {
            var t = Math.min((now - start) / 900, 1)
            el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3))) + suffix
            if (t < 1) requestAnimationFrame(frame)
          }
          requestAnimationFrame(frame)
        }

        addEventListener('scroll', schedule, { passive: true })
        addEventListener('resize', schedule)
        addEventListener('load', schedule)
        // A background tab pauses rAF, so anything queued while hidden never
        // ran. Sweep again the moment the tab is looked at.
        addEventListener('visibilitychange', function () {
          if (!document.hidden) schedule()
        })
        sweep()
      })()
    </script>
  </body>
</html>
