---
import '@/styles/global.css'
import { site, faq } from '@/data/copy'

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpsMaxx" />
    <meta property="og:image" content={`${site.url}/shots/fleet.png`} />
    <meta property="og:image:width" content="1800" />
    <meta property="og:image:height" content="908" />
    <meta property="og:image:alt" content="The OpsMaxx fleet monitor: fifteen servers with live CPU, memory, disk and network" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.url}/shots/fleet.png`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/shots/fleet.webp" type="image/webp" fetchpriority="high" />

    <!-- Consent, then the banner, then analytics. Order matters: the defaults
         have to be on the dataLayer before gtag.js loads, or Google Analytics
         fires once before anyone has been asked. CookieYes flips these to
         granted with a consent update when the visitor accepts.

         This needs "Google Consent Mode" switched on in the CookieYes
         dashboard. Without it nothing ever sends the update and analytics
         stays denied forever — quietly, which is the failure mode to watch
         for if the GA4 property shows no traffic. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500
      })
    </script>

    <script
      is:inline
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/a2d4a67c0b1af9ee19ba19c5f66a12ae/script.js"
    ></script>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PF96S41GE7"></script>
    <script is:inline>
      gtag('js', new Date())
      gtag('config', 'G-PF96S41GE7')
    </script>

    <!-- Light is the default. Only a stored preference turns the page dark,
         so a first-time visitor never gets a flash of the wrong theme. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark')
        }
      } catch (e) {}
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a }
        }))
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'OpsMaxx',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Windows, macOS, Linux',
        softwareVersion: site.version,
        license: 'https://opensource.org/licenses/MIT',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        url: site.url
      })}
    />
  </head>
  <body class="min-h-screen bg-background font-sans">
    <slot />

    <!-- Reveal-on-scroll and the counters. Deliberately not a framework:
         a single rAF-throttled pass, no hydration, and it degrades to
         "everything visible" if it never runs. The pass is a sweep rather
         than an observer so that scrolling past a section quickly can never
         leave it stuck invisible. -->
    <script is:inline>
      ;(function () {
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
        var pending = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'))

        function showAll() {
          pending.forEach(function (el) { el.classList.add('is-static') })
          document.querySelectorAll('[data-count]').forEach(function (el) {
            el.textContent = el.getAttribute('data-count')
          })
          pending = []
        }

        if (reduced) return showAll()

        // Stagger siblings inside a group, so a grid arrives as a wave.
        document.querySelectorAll('[data-reveal-group]').forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (child, i) {
            var el = child.hasAttribute('data-reveal') ? child : child.querySelector('[data-reveal]')
            if (el) el.style.setProperty('--reveal-delay', Math.min(i, 8) * 55 + 'ms')
          })
        })

        var queued = false
        function schedule() {
          if (queued) return
          queued = true
          requestAnimationFrame(sweep)
        }

        function sweep() {
          queued = false
          var limit = innerHeight * 0.9
          var still = []
          for (var i = 0; i < pending.length; i++) {
            var el = pending[i]
            if (el.getBoundingClientRect().top < limit) {
              el.classList.add('is-in')
              var c = el.matches('[data-count]') ? el : el.querySelector('[data-count]')
              if (c) count(c)
            } else {
              still.push(el)
            }
          }
          pending = still
          if (!pending.length) {
            removeEventListener('scroll', schedule)
            removeEventListener('resize', schedule)
          }
        }

        // Counts up to the number in data-count, keeping any suffix ("20+").
        function count(el) {
          if (el.dataset.counted) return
          el.dataset.counted = '1'
          var raw = el.getAttribute('data-count')
          var target = parseInt(raw, 10)
          if (isNaN(target)) return
          var suffix = raw.replace(/^[0-9]+/, '')
          if (target === 0) { el.textContent = '0' + suffix; return }
          var start = performance.now()
          function frame(now) {
            var t = Math.min((now - start) / 900, 1)
            el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3))) + suffix
            if (t < 1) requestAnimationFrame(frame)
          }
          requestAnimationFrame(frame)
        }

        addEventListener('scroll', schedule, { passive: true })
        addEventListener('resize', schedule)
        addEventListener('load', schedule)
        // A background tab pauses rAF, so anything queued while hidden never
        // ran. Sweep again the moment the tab is looked at.
        addEventListener('visibilitychange', function () {
          if (!document.hidden) schedule()
        })
        sweep()
      })()
    </script>

    <!-- Download and platform tracking.
         GA4's enhanced measurement fires file_download for .exe but not for
         .dmg, .AppImage or .deb, so left alone it would count every Windows
         download and none of the Mac or Linux ones — a worse dataset than no
         dataset. This fires one event for any release asset, whatever the
         extension, which is why it is named app_download rather than
         file_download: the .exe would otherwise be counted twice.

         Delegated from the document, so links rendered later by an island are
         covered without the islands knowing anything about analytics. gtag
         itself honours consent, so nothing is sent before someone accepts. -->
    <script is:inline>
      ;(function () {
        var PLATFORM = [
          [/\.dmg$/i, 'macos'],
          [/\.exe$/i, 'windows'],
          [/\.AppImage$/i, 'linux'],
          [/\.deb$/i, 'linux']
        ]

        document.addEventListener(
          'click',
          function (e) {
            var t = e.target
            if (!t || !t.closest) return

            var link = t.closest('a[href*="/releases/download/"]')
            if (link) {
              var url = link.getAttribute('href') || ''
              var file = url.split('/').pop() || ''
              var version = (url.match(/\/download\/v?([^/]+)\//) || [])[1] || ''
              var platform = 'unknown'
              for (var i = 0; i < PLATFORM.length; i++) {
                if (PLATFORM[i][0].test(file)) { platform = PLATFORM[i][1]; break }
              }
              gtag('event', 'app_download', {
                platform: platform,
                file_name: file,
                file_extension: (file.split('.').pop() || '').toLowerCase(),
                app_version: version,
                // Which block on the page earned the click.
                source: (link.closest('section') || {}).id || 'header',
                link_url: url
              })
              return
            }

            // Switching the install tab says what someone runs even when they
            // do not download, which is the only read on audience mix that
            // does not depend on a conversion.
            var tab = t.closest('#install [role="tab"]')
            if (tab) {
              gtag('event', 'install_platform_select', {
                platform: (tab.textContent || '').trim().toLowerCase()
              })
            }
          },
          true
        )
      })()
    </script>
  </body>
</html>
