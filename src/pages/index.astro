---
import Base from '@/layouts/Base.astro'
import { getRelease } from '@/lib/releases'
import { ProductTour } from '@/components/islands/ProductTour'
import { Install } from '@/components/islands/Install'
import { Faq } from '@/components/islands/Faq'
import { ThemeToggle } from '@/components/islands/ThemeToggle'
import { McpFlow } from '@/components/islands/McpFlow'
import { DownloadButton } from '@/components/islands/DownloadButton'
import { IconTile } from '@/components/reui/icon-tile'
import { buttonVariants } from '@/components/ui/button'
import {
  ArrowDownToLine, ArrowRight, Bot, Briefcase, Database, FolderTree, Keyboard,
  Layers, Lock, Minus, Network, Server, ShieldCheck, Siren, TerminalSquare
} from 'lucide-react'
import {
  site, hero, stats, featuresSection, features, operations, personas,
  ai, install, finalCta
} from '@/data/copy'

const release = await getRelease()

const icons = {
  terminal: TerminalSquare, folder: FolderTree, database: Database, network: Network,
  lock: Lock, server: Server, bot: Bot, layers: Layers, keyboard: Keyboard,
  siren: Siren, briefcase: Briefcase
}
---

<Base>
  <header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-6">
      <a href="/" class="flex items-center gap-2.5 text-[0.98rem] font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        OpsMaxx
      </a>
      <div class="flex items-center gap-1">
        <a href="#tour" class="hidden px-3.5 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground md:block">Tour</a>
        <a href="#operations" class="hidden px-3.5 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground lg:block">Operations</a>
        <a href="#agents" class="hidden px-3.5 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground md:block">MCP</a>
        <a href="#faq" class="hidden px-3.5 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground md:block">FAQ</a>
        <ThemeToggle client:idle />
        <a href={site.repo} class={buttonVariants({ variant: 'ghost', size: 'icon-sm' }) + ' text-muted-foreground'} aria-label="GitHub">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>
        <DownloadButton release={release} size="sm" className="ml-1.5" client:load />
      </div>
    </nav>
  </header>

  <!-- ───────────────────────────────────────────────────────────── hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[34rem] bg-gradient-to-b from-brand-soft to-transparent"></div>

    <div class="mx-auto max-w-6xl px-5 pb-16 pt-16 sm:px-6 sm:pb-20 sm:pt-28">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3.5 py-1.5 text-[0.78rem] font-medium text-muted-foreground">
          <span class="size-1.5 rounded-full bg-brand"></span>
          {hero.eyebrow}
        </span>

        <h1 class="mt-7 text-[2.15rem] font-semibold leading-[1.08] xs:text-[2.6rem] sm:text-[3.9rem]">
          {hero.h1}
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-muted-foreground sm:text-[1.15rem]">
          {hero.sub}
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <DownloadButton release={release} showMeta client:load className="w-full sm:w-auto" />
          <a href={site.repo} class={buttonVariants({ variant: 'outline', size: 'lg' }) + ' w-full sm:w-auto'}>
            {hero.ctaSecondary}
          </a>
        </div>

        <p class="mt-5 text-[0.85rem] text-muted-foreground">{hero.trust}</p>
      </div>

      <figure class="mt-16 sm:mt-20" data-reveal>
        <img
          src={hero.shot.src}
          alt={hero.shot.alt}
          width="1800"
          height="908"
          fetchpriority="high"
          decoding="async"
          class="shot-frame w-full"
        />
        <figcaption class="mt-4 text-center font-mono text-[0.72rem] uppercase tracking-[0.14em] text-muted-foreground">
          {hero.shot.caption}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────── stats -->
  <section class="border-y border-border bg-band">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 py-14 sm:grid-cols-3 sm:gap-6" data-reveal-group>
      {stats.map((s) => (
        <div class="text-center" data-reveal>
          <div class="text-4xl font-semibold tracking-tight tabular-nums text-brand" data-count={s.n}>{s.n}</div>
          <div class="mx-auto mt-2 max-w-[14rem] text-[0.9rem] leading-snug text-muted-foreground">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────────────────────────────────────────────────────────── tour -->
  <section id="tour" class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-32">
    <ProductTour client:visible />
  </section>

  <!-- ────────────────────────────────────────────────────────── features -->
  <section class="border-y border-border bg-band">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{featuresSection.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-[2.6rem]">{featuresSection.headline}</h2>
        <p class="mt-5 text-[1.02rem] leading-relaxed text-muted-foreground">{featuresSection.deck}</p>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {features.map((f) => {
          const Icon = icons[f.icon as keyof typeof icons]
          return (
            <article
              data-reveal
              class:list={[
                'lift lift-hover group rounded-2xl border border-border bg-background p-6 sm:p-7',
                f.span === 'wide' && 'sm:col-span-2'
              ]}
            >
              <IconTile variant="soft" size="default" className="text-brand">
                <Icon />
              </IconTile>
              <h3 class="mt-5 text-[1.05rem] font-semibold leading-snug">{f.name}</h3>
              <p class="mt-2.5 max-w-lg text-[0.92rem] leading-relaxed text-muted-foreground">{f.line}</p>
              {f.chips && (
                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {f.chips.map((c) => (
                    <li class="rounded-md border border-border bg-band px-2 py-1 font-mono text-[0.68rem] text-muted-foreground transition-colors duration-300 group-hover:border-brand/25 group-hover:text-foreground/70">
                      {c}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────── operations -->
  <section id="operations" class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-32">
    <div class="max-w-3xl">
      <div data-reveal>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{operations.eyebrow}</p>
        <h2 class="mt-4 max-w-xl text-3xl font-semibold leading-tight sm:text-[2.6rem]">{operations.headline}</h2>
        <p class="mt-5 max-w-xl text-[1.02rem] leading-relaxed text-muted-foreground">{operations.deck}</p>
      </div>
</div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-border bg-border lg:grid-cols-3" data-reveal-group>
      {operations.groups.map((g) => (
        <div class="bg-background p-6 sm:p-7" data-reveal>
          <h3 class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-muted-foreground">{g.title}</h3>
          <ul class="mt-6 space-y-5">
            {g.items.map(([name, detail]) => (
              <li>
                <p class="text-[0.92rem] font-medium">{name}</p>
                <p class="mt-1 text-[0.83rem] leading-relaxed text-muted-foreground">{detail}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-6 text-center text-[0.83rem] text-muted-foreground" data-reveal>{operations.footnote}</p>
  </section>

  <!-- ───────────────────────────────────────────────────────── personas -->
  <section class="border-y border-border bg-band">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{personas.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-[2.6rem]">{personas.headline}</h2>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-2" data-reveal-group>
        {personas.items.map((p) => {
          const Icon = icons[p.icon as keyof typeof icons]
          return (
            <article class="lift lift-hover rounded-2xl border border-border bg-background p-6 sm:p-7" data-reveal>
              <div class="flex items-center gap-3">
                <IconTile variant="soft" size="default" className="text-brand">
                  <Icon />
                </IconTile>
                <h3 class="text-[1.05rem] font-semibold">{p.role}</h3>
              </div>
              <p class="mt-4 text-[0.92rem] leading-relaxed text-muted-foreground">{p.line}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {p.tags.map((t) => (
                  <li class="rounded-md bg-brand-soft px-2 py-1 font-mono text-[0.68rem] text-brand">{t}</li>
                ))}
              </ul>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────── mcp -->
  <section id="agents" class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-32">
    <div class="max-w-2xl" data-reveal>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{ai.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-[2.6rem]">{ai.headline}</h2>
      <p class="mt-6 text-[1.02rem] leading-relaxed text-muted-foreground">{ai.body}</p>
      <ul class="mt-7 flex flex-wrap gap-1.5">
        {ai.clients.map((c) => (
          <li class="rounded-md border border-border bg-band px-2.5 py-1 font-mono text-[0.7rem] text-muted-foreground">{c}</li>
        ))}
      </ul>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-3" data-reveal-group>
      <!-- the pipeline -->
      <div class="min-w-0 rounded-2xl border border-border bg-background p-6 sm:p-7" data-reveal>
        <h3 class="text-[0.82rem] font-medium text-muted-foreground">One request, end to end</h3>
        <div class="mt-7">
          <McpFlow client:visible />
        </div>
      </div>

      <!-- the tools -->
      <div class="min-w-0 rounded-2xl border border-border bg-background p-6 sm:p-7" data-reveal>
        <h3 class="text-[0.82rem] font-medium text-muted-foreground">
          <span class="tabular-nums text-foreground" data-count={String(ai.toolCount)}>{ai.toolCount}</span> tools an agent can call
        </h3>
        <div class="mt-6 space-y-5">
          {ai.toolGroups.map((g) => (
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-brand">{g.title}</p>
              <ul class="mt-2 flex flex-wrap gap-1">
                {g.tools.map((t) => (
                  <li class="rounded border border-border bg-band px-1.5 py-0.5 font-mono text-[0.66rem] text-muted-foreground">{t}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-6 text-[0.83rem] leading-relaxed text-muted-foreground">
          Each one is governed separately — ALLOW, ASK or DENY — and file paths can be
          overridden on top of that.
        </p>
      </div>

      <!-- what it never gets -->
      <div class="flex min-w-0 flex-col rounded-2xl border border-border bg-band p-6 sm:p-7" data-reveal>
        <h3 class="text-[0.82rem] font-medium text-muted-foreground">{ai.neverLabel}</h3>
        <ul class="mt-6">
          {ai.never.map((n) => (
            <li class="flex items-center gap-3 border-b border-border/70 py-3 first:pt-0 last:border-0">
              <Minus className="size-3.5 shrink-0 text-muted-foreground/50" />
              <span class="text-[0.92rem]">{n}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-[0.83rem] leading-relaxed text-muted-foreground">{ai.closing}</p>
        <div class="mt-auto pt-7">
          <p class="text-[0.78rem] text-muted-foreground">Connect Claude Code:</p>
          <pre class="mt-2 overflow-x-auto rounded-lg border border-brand/25 bg-brand-soft px-3.5 py-2.5 font-mono text-[0.78rem] text-brand"><code>{ai.pairing}</code></pre>
        </div>
      </div>
    </div>

    <div class="mt-10" data-reveal>
      <a href={site.repo + '/blob/main/docs/AI-SECURITY.md'} class={buttonVariants({ variant: 'outline' })}>
        {ai.cta}
        <ArrowRight className="size-4" />
      </a>
    </div>
  </section>

  <!-- ────────────────────────────────────────────────────────── install -->
  <section id="install" class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-32">
    <div class="max-w-2xl" data-reveal>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{install.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-[2.6rem]">{install.headline}</h2>
      <p class="mt-5 text-[1.02rem] leading-relaxed text-muted-foreground">{install.deck}</p>
    </div>

    <div class="mt-12" data-reveal>
      <Install release={release} client:load />
    </div>
  </section>

  <!-- ────────────────────────────────────────────────────────────── faq -->
  <section id="faq" class="border-t border-border bg-band">
    <div class="mx-auto max-w-3xl px-5 sm:px-6 py-20 sm:py-32">
      <h2 class="text-3xl font-semibold sm:text-[2.4rem]" data-reveal>Questions people ask first</h2>
      <div class="mt-10">
        <Faq client:visible />
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────── final cta -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-3xl px-5 sm:px-6 py-28 text-center sm:py-36">
      <h2 class="text-[2.4rem] font-semibold leading-tight sm:text-[3.2rem]">{finalCta.headline}</h2>
      <p class="mx-auto mt-5 max-w-md text-[1.02rem] text-muted-foreground">{finalCta.line}</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <DownloadButton release={release} showMeta client:load className="w-full sm:w-auto" />
        <a href={site.repo} class={buttonVariants({ variant: 'outline', size: 'lg' }) + ' w-full sm:w-auto'}>
          {finalCta.secondary}
        </a>
      </div>
    </div>
  </section>

  <footer class="border-t border-border bg-band">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 sm:px-6 text-[0.86rem] text-muted-foreground sm:flex-row">
      <span>OpsMaxx {site.version} · MIT licensed · {site.domain}</span>
      <div class="flex items-center gap-6">
        <a href={site.repo} class="transition-colors hover:text-foreground">GitHub</a>
        <a href={site.repo + '/blob/main/SECURITY.md'} class="transition-colors hover:text-foreground">Security</a>
        <a href={site.releases} class="transition-colors hover:text-foreground">Releases</a>
      </div>
    </div>
  </footer>
</Base>
