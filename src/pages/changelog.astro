---
import Base from '@/layouts/Base.astro'
import { buttonVariants } from '@/components/ui/button'
import { ArrowLeft, ArrowUpRight } from 'lucide-react'
import { site } from '@/data/copy'
import { getChangelog, SHOWN } from '@/lib/changelog'
import { getRelease } from '@/lib/releases'

const { releases, total, degraded } = await getChangelog()
const release = await getRelease()

const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
    .format(new Date(iso))

const title = 'Changelog — OpsMaxx'
const description = `Every OpsMaxx release, newest first: what changed in each one, taken from the commits between tags. ${total} releases so far.`
---

<Base title={title} description={description} version={release.version}>
  <header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 sm:px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5 text-[0.98rem] font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        OpsMaxx
      </a>
      <a href="/" class="flex items-center gap-2 px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground">
        <ArrowLeft className="size-3.5" />
        Back to the site
      </a>
    </nav>
  </header>

  <main class="mx-auto max-w-3xl px-5 sm:px-6">
    <section class="border-b border-border py-16 sm:py-20">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">Changelog</p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight sm:text-[2.6rem]">What changed, and when.</h1>
      <p class="mt-6 max-w-2xl text-[1.02rem] leading-relaxed text-muted-foreground">
        {degraded
          ? 'The release notes live on GitHub.'
          : `${total} releases so far. Each entry is the commits between that tag and the one before it — the same list a maintainer reads, not a summary written afterwards.`}
      </p>
    </section>

    {degraded && (
      <section class="py-16">
        <p class="text-[0.95rem] leading-relaxed text-muted-foreground">
          This page is built from the GitHub API and the build could not reach it. Nothing is
          wrong with the releases themselves.
        </p>
        <a href={site.releases} class={buttonVariants({ variant: 'outline' }) + ' mt-6'}>
          Releases on GitHub
          <ArrowUpRight className="size-4" />
        </a>
      </section>
    )}

    {releases.map((r, i) => (
      <article class="border-b border-border py-10 sm:py-12">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 class="text-xl font-semibold tracking-tight">
            <a href={r.url} class="transition-colors hover:text-brand">{r.version}</a>
          </h2>
          <time datetime={r.date} class="font-mono text-[0.76rem] text-muted-foreground">{fmt(r.date)}</time>
          {i === 0 && (
            <span class="rounded-full bg-brand-soft px-2 py-0.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-brand">
              latest
            </span>
          )}
        </div>

        {r.changes.length > 0 ? (
          <ul class="mt-5 space-y-2.5">
            {r.changes.map((c) => (
              <li class="flex gap-3 text-[0.95rem] leading-relaxed">
                <span class="mt-[0.6rem] size-1 shrink-0 rounded-full bg-brand/60" />
                <span>{c}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-5 text-[0.93rem] text-muted-foreground">
            No commits recorded between this tag and the one before it.
          </p>
        )}

        {r.compareUrl && (
          <a
            href={r.compareUrl}
            class="mt-5 inline-flex items-center gap-1.5 font-mono text-[0.74rem] text-muted-foreground underline-offset-4 transition-colors hover:text-brand hover:underline"
          >
            full diff
            <ArrowUpRight className="size-3" />
          </a>
        )}
      </article>
    ))}

    {!degraded && total > SHOWN && (
      <section class="py-14 text-center">
        <p class="text-[0.95rem] text-muted-foreground">
          {total - releases.length} earlier releases are on GitHub.
        </p>
        <a href={site.releases} class={buttonVariants({ variant: 'outline' }) + ' mt-5'}>
          See all {total} releases
          <ArrowUpRight className="size-4" />
        </a>
      </section>
    )}
  </main>

  <footer class="border-t border-border bg-band">
    <div class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-4 px-5 py-10 text-[0.86rem] text-muted-foreground sm:flex-row sm:px-6">
      <span>OpsMaxx {release.version ? `v${release.version}` : ''} · MIT licensed · {site.domain}</span>
      <div class="flex items-center gap-6">
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
        <a href="/mcp/" class="transition-colors hover:text-foreground">MCP</a>
        <a href={site.repo} class="transition-colors hover:text-foreground">GitHub</a>
      </div>
    </div>
  </footer>
</Base>
