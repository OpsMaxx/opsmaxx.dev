---
import Base from '@/layouts/Base.astro'
import { McpFlow } from '@/components/islands/McpFlow'
import { buttonVariants } from '@/components/ui/button'
import { ArrowLeft, ArrowRight, Minus } from 'lucide-react'
import { site } from '@/data/copy'
import { mcpPage } from '@/data/mcp'

const toolCount = mcpPage.groups.reduce((n, g) => n + g.tools.length, 0)
---

<Base title={mcpPage.title} description={mcpPage.description}>
  <header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-6">
      <a href="/" class="flex shrink-0 items-center gap-2.5 text-[0.98rem] font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        OpsMaxx
      </a>
      <a href="/" class="flex items-center gap-2 px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground">
        <ArrowLeft className="size-3.5" />
        Back to the site
      </a>
    </nav>
  </header>

  <main class="mx-auto max-w-5xl px-5 sm:px-6">
    <section class="border-b border-border py-16 sm:py-24">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{mcpPage.eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold leading-tight sm:text-[2.9rem]">{mcpPage.h1}</h1>
      <p class="mt-6 max-w-2xl text-[1.02rem] leading-relaxed text-muted-foreground">{mcpPage.sub}</p>
    </section>

    <section class="grid gap-12 border-b border-border py-16 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16 sm:py-20">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">One request, end to end</h2>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-muted-foreground">
          The same path whether the client speaks HTTP or stdio. Nothing about the
          policy changes because of how an agent connected.
        </p>
      </div>
      <div class="rounded-2xl border border-border bg-band p-6 sm:p-8">
        <McpFlow client:visible />
      </div>
    </section>

    <section class="border-b border-border py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">{mcpPage.capabilities.title}</h2>
      <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-muted-foreground">{mcpPage.capabilities.body}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {mcpPage.capabilities.states.map((s) => (
          <div class="rounded-xl border border-border p-5">
            <p class="font-mono text-[0.75rem] font-medium tracking-[0.12em] text-brand">{s.name}</p>
            <p class="mt-2 text-[0.88rem] leading-relaxed text-muted-foreground">{s.line}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="tools" class="border-b border-border py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">
        The {toolCount} tools an agent can call
      </h2>
      <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-muted-foreground">
        Each one is governed separately by the access group. Summaries here are condensed
        from the descriptions the server sends to the client, so an agent and a reader are
        told the same thing.
      </p>

      <div class="mt-10 space-y-10">
        {mcpPage.groups.map((g) => (
          <div>
            <h3 class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-brand">{g.title}</h3>
            <dl class="mt-4 divide-y divide-border border-y border-border">
              {g.tools.map(([name, desc]) => (
                <div class="grid gap-1 py-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:gap-6">
                  <dt class="font-mono text-[0.82rem] text-foreground [overflow-wrap:anywhere]">{name}</dt>
                  <dd class="text-[0.9rem] leading-relaxed text-muted-foreground">{desc}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section class="border-b border-border py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">{mcpPage.never.title}</h2>
      <ul class="mt-6 grid max-w-3xl gap-x-10 sm:grid-cols-2">
        {mcpPage.never.items.map((n) => (
          <li class="flex items-center gap-3 border-b border-border/70 py-3">
            <Minus className="size-3.5 shrink-0 text-muted-foreground/50" />
            <span class="text-[0.93rem]">{n}</span>
          </li>
        ))}
      </ul>
      <p class="mt-7 max-w-2xl border-l-2 border-brand/40 pl-5 text-[0.93rem] leading-relaxed text-foreground/75">
        {mcpPage.never.closing}
      </p>
      <a href={site.repo + '/blob/main/docs/AI-SECURITY.md'} class={buttonVariants({ variant: 'outline' }) + ' mt-8'}>
        Read the threat model
        <ArrowRight className="size-4" />
      </a>
    </section>

    <section id="connect" class="py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-tight">{mcpPage.clients.title}</h2>
      <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-muted-foreground">{mcpPage.clients.body}</p>

      <div class="mt-10 space-y-8">
        {mcpPage.clients.items.map((c) => (
          <div class="grid gap-4 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] lg:gap-10">
            <div>
              <h3 class="text-[1rem] font-semibold">{c.name}</h3>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-muted-foreground">{c.body}</p>
            </div>
            <pre class="min-w-0 overflow-x-auto rounded-lg border border-border bg-band px-4 py-3.5 font-mono text-[0.78rem] leading-6 [overflow-wrap:anywhere] whitespace-pre-wrap"><code>{c.cmd}</code></pre>
          </div>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-border bg-band">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-5 py-10 text-[0.86rem] text-muted-foreground sm:flex-row sm:px-6">
      <span>OpsMaxx {site.version} · MIT licensed · {site.domain}</span>
      <div class="flex items-center gap-6">
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
        <a href={site.repo} class="transition-colors hover:text-foreground">GitHub</a>
        <a href={site.releases} class="transition-colors hover:text-foreground">Releases</a>
      </div>
    </div>
  </footer>
</Base>
