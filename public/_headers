/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # The release-notification form posts to a third-party endpoint with
  # target=_blank, and `rel` is not a valid <form> attribute — so this is the
  # only way to deny that tab a live window.opener. Covers every future _blank.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Astro emits content-hashed filenames under /_astro, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=2592000

# Screenshots are not content-hashed, so a week with revalidation in the
# background rather than the immutable year the /_astro assets get.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/shots/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML is not hashed and must revalidate.
/*.html
  Cache-Control: public, max-age=300, must-revalidate
